rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasUserRoot(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidUserRoot(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMission(data, userId) {
      return data.keys().hasAll(['ownerId', 'kind', 'title', 'summary', 'riskLevel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'kind', 'title', 'summary', 'riskLevel', 'modelUsed', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.kind is string
        && data.kind in ['report', 'rules', 'ai_session']
        && data.title is string
        && data.title.size() >= 1 && data.title.size() <= 160
        && data.summary is string
        && data.summary.size() >= 1 && data.summary.size() <= 4000
        && data.riskLevel is string
        && data.riskLevel in ['LOW', 'MODERATE', 'HIGH', 'INFO']
        && (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWaypoint(data, userId) {
      return data.keys().hasAll(['ownerId', 'label', 'classification', 'score', 'gridX', 'gridY', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'label', 'classification', 'score', 'latitude', 'longitude', 'gridX', 'gridY', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.label is string
        && data.label.size() >= 1 && data.label.size() <= 120
        && data.classification is string
        && data.classification in ['positive', 'negative', 'neutral']
        && data.score is number && data.score >= 0 && data.score <= 1
        && data.gridX is number && data.gridX >= 0 && data.gridX <= 100
        && data.gridY is number && data.gridY >= 0 && data.gridY <= 100
        && (!('latitude' in data) || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['ownerId', 'role', 'text', 'modelUsed', 'groundingMode', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'role', 'text', 'modelUsed', 'groundingMode', 'sourceUrls', 'createdAt'])
        && data.ownerId is string
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.role is string
        && data.role in ['user', 'model']
        && data.text is string
        && data.text.size() >= 1 && data.text.size() <= 12000
        && data.modelUsed is string
        && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 80
        && data.groundingMode is string
        && data.groundingMode in ['none', 'search', 'maps']
        && (!('sourceUrls' in data) || (
          data.sourceUrls is list
          && data.sourceUrls.size() <= 8
          && (data.sourceUrls.size() == 0 || (data.sourceUrls[0] is string && data.sourceUrls[0].size() <= 512))
        ))
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserRoot(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserRoot(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && isVerifiedOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidPrivateInfo(incoming(), userId)
          && hasUserRoot(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'photoURL', 'updatedAt']);
        allow delete: if isValidId(userId) && docId == 'info' && isVerifiedOwner(userId);
      }

      match /missions/{missionId} {
        allow get: if isValidId(userId) && isValidId(missionId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(missionId)
          && isVerifiedOwner(userId)
          && isValidMission(incoming(), userId)
          && hasUserRoot(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(missionId)
          && isVerifiedOwner(userId)
          && isValidMission(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'riskLevel', 'modelUsed', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(missionId) && isVerifiedOwner(userId);
      }

      match /waypoints/{waypointId} {
        allow get: if isValidId(userId) && isValidId(waypointId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(waypointId)
          && isVerifiedOwner(userId)
          && isValidWaypoint(incoming(), userId)
          && hasUserRoot(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(waypointId)
          && isVerifiedOwner(userId)
          && isValidWaypoint(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'classification', 'score', 'latitude', 'longitude', 'gridX', 'gridY', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(waypointId) && isVerifiedOwner(userId);
      }

      match /chatMessages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isVerifiedOwner(userId);
        allow list: if isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(messageId)
          && isVerifiedOwner(userId)
          && isValidChatMessage(incoming(), userId)
          && hasUserRoot(userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(messageId) && isVerifiedOwner(userId);
      }
    }
  }
}
